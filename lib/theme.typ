// Shared look for all documents. Change fonts, sizes and colors here only.

#let font = "New Computer Modern"

#let sizes = (
  body: 12pt,
  subject: 13.5pt,
  name: 20.7pt,
  small: 11pt,
  footer: 10pt,
)

#let colors = (
  // Muted blue: reads as a link without shouting.
  link: rgb("#1A4FA0"),
)

#let strokes = (
  thin: 0.4pt,
)
